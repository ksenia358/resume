# URL PHP-эндпоинта формы обратной связи. По умолчанию /api/contact.php (тот же хостинг).
VITE_CONTACT_API_URL=
# URL PHP-эндпоинта с данными резюме. По умолчанию /api/resume.php (тот же хостинг).
VITE_RESUME_API_URL=
# Откуда брать резюме: json (по умолчанию в yarn dev) или api (по умолчанию на сайте, с запасным JSON).
VITE_RESUME_SOURCE=
